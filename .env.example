# Copie este arquivo para .env e ajuste se precisar.

# Porta do servidor
PORT=3000

# Segredo usado para assinar os tokens de login.
# Se ficar vazio, o servidor gera um automaticamente em data/.jwt-secret
JWT_SECRET=

# Fuso horário usado para agrupar o consumo por dia e por hora
TZ=America/Sao_Paulo

# Modo demonstração: mostra a conta de teste no login e libera os botões
# de simulação (banho, vazamento...) na tela "Meu dispositivo".
# Use false quando o sensor de verdade estiver ligado.
DEMO_MODE=true

# Banco de dados na nuvem (TiDB Cloud ou MySQL). Se ficar vazio, usa o SQLite local (data/gotalert.db).
# No TiDB Cloud: Connect > Connect With "General" > copie usuário, senha e host.
# Formato: mysql://USUARIO:SENHA@HOST:4000/gotalert
DATABASE_URL=
